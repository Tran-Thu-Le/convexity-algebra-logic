%% ==== Block 4.4: Order structure -- goal OS4 ====
%% Bai bao / paper: prop:order-structure (doc3-structures.tex)
%% Goal: ev is least:  ev <= x
%% Gia thiet / hypotheses: Du 11 tien de. All 11 axioms.
%% Ky hieu / notation: v = join, * = tensor, star() = polarity,
%%   ev = e_join, eo = e_tensor; meet/plus/ew/ep are DEFINED below.

assign(max_seconds, 60).

op(400, infix, "v").
op(450, infix, "*").

formulas(assumptions).

  % J0: join idempotence
  x v x = x.

  % J1: join associativity
  (x v y) v z = x v (y v z).

  % J2: join commutativity
  x v y = y v x.

  % J3: join unit
  x v ev = x.

  % T1: tensor associativity
  (x * y) * z = x * (y * z).

  % T2: tensor commutativity
  x * y = y * x.

  % T3: tensor unit
  x * eo = x.

  % TJ1: tensor distributes over join
  x * (y v z) = (x * y) v (x * z).

  % TJ2: ev absorbing for tensor
  x * ev = ev.

  % P: involution
  star(star(x)) = x.

  % PJ: polarity / order-compatibility
  (x v y = y) <-> (star(y) v star(x) = star(x)).

  % D-meet: a /\ b := (a^* v b^*)^*
  meet(x,y) = star(star(x) v star(y)).

  % D-plus: a (+) b := (a^* * b^*)^*
  plus(x,y) = star(star(x) * star(y)).

  % D-ew: e_/\ := (e_v)^*
  ew = star(ev).

  % D-ep: e_(+) := (e_*)^*
  ep = star(eo).

end_of_list.

formulas(goals).

  % OS4: ev is least:  ev <= x
  ev v x = x.

end_of_list.
