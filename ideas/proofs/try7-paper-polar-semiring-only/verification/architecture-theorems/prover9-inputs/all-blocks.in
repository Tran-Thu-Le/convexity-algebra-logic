  ew = star(ev).

  % D-ep: e_(+) := (e_*)^*
  ep = star(eo).

end_of_list.

formulas(goals).

  % OC1: join/meet compatibility
  (x v y = y) <-> (meet(y,x) = x).

end_of_list.


