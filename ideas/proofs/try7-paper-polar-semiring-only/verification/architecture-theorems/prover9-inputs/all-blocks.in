%% ==== Block 1.1: Duality laws -- goal RD1 ====
%% Bai bao / paper: prop:duality (doc3-structures.tex)
%% Goal: De Morgan for meet
%% Gia thiet / hypotheses: Chi (P) + hai monoid — KHONG co J0/TJ1/TJ2/PJ. Only (P) plus the two monoids; no J0/TJ1/TJ2/PJ.
%% Ky hieu / notation: v = join, * = tensor, star() = polarity,
%%   ev = e_join, eo = e_tensor; meet/plus/ew/ep are DEFINED below.

assign(max_seconds, 60).

op(400, infix, "v").
op(450, infix, "*").

formulas(assumptions).

  % J1: join associativity
  (x v y) v z = x v (y v z).

  % J2: join commutativity
  x v y = y v x.

  % J3: join unit
  x v ev = x.

  % T1: tensor associativity
  (x * y) * z = x * (y * z).

  % T2: tensor commutativity
  x * y = y * x.

  % T3: tensor unit
  x * eo = x.

  % P: involution
  star(star(x)) = x.

  % D-meet: a /\ b := (a^* v b^*)^*
  meet(x,y) = star(star(x) v star(y)).

  % D-plus: a (+) b := (a^* * b^*)^*
  plus(x,y) = star(star(x) * star(y)).

  % D-ew: e_/\ := (e_v)^*
  ew = star(ev).

  % D-ep: e_(+) := (e_*)^*
  ep = star(eo).

end_of_list.

formulas(goals).

  % RD1: De Morgan for meet
  star(meet(x,y)) = star(x) v star(y).

end_of_list.


