  (x * y) * z = x * (y * z).

  % T2: tensor commutativity
  x * y = y * x.

  % T3: tensor unit
  x * eo = x.

  % TJ1: tensor distributes over join
  x * (y v z) = (x * y) v (x * z).

  % TJ2: ev absorbing for tensor
  x * ev = ev.

  % P: involution
  star(star(x)) = x.

  % PJ: polarity / order-compatibility
  (x v y = y) <-> (star(y) v star(x) = star(x)).

  % D-meet: a /\ b := (a^* v b^*)^*
  meet(x,y) = star(star(x) v star(y)).

  % D-plus: a (+) b := (a^* * b^*)^*
  plus(x,y) = star(star(x) * star(y)).

  % D-ew: e_/\ := (e_v)^*
  ew = star(ev).

  % D-ep: e_(+) := (e_*)^*
  ep = star(eo).

end_of_list.

formulas(goals).

  % OS9: meet is the greatest lower bound
  ((z v x = x) & (z v y = y)) -> (z v meet(x,y) = meet(x,y)).

end_of_list.


