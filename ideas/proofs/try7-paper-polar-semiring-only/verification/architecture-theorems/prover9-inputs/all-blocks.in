  ew = star(ev).

  % D-ep: e_(+) := (e_*)^*
  ep = star(eo).

end_of_list.

formulas(goals).

  % RS2c: ep is a unit for plus
  plus(x,ep) = x.

end_of_list.


%% ==== Block 3.1: Order compatibility -- goal OC1 ====
