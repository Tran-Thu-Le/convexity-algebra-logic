  ((x * y) v z = z) <-> (y v res(x,z) = res(x,z)).

  % BGA4a: polarity defined from the residual
  star(x) = res(x, ep).

  % BGA4b: the polarity is involutive
  star(star(x)) = x.

  % BGA5: ew is the greatest element
  x v ew = ew.

  % D-ev: least element ev := star(ew)
  ev = star(ew).

end_of_list.

formulas(goals).

  % the two lattice orders agree:  x v y = y  <->  mt(x,y) = x
  (x v y = y) <-> (mt(x,y) = x).

end_of_list.
