op(400, infix, "v").
op(450, infix, "*").

formulas(assumptions).

  % BGA1a: join idempotent
  x v x = x.

  % BGA1b: join commutative
  x v y = y v x.

  % BGA1c: join associative
  (x v y) v z = x v (y v z).

  % BGA1d: meet idempotent
  mt(x,x) = x.

  % BGA1e: meet commutative
  mt(x,y) = mt(y,x).

  % BGA1f: meet associative
  mt(mt(x,y),z) = mt(x,mt(y,z)).

  % BGA1g: absorption 1
  x v mt(x,y) = x.

  % BGA1h: absorption 2
  mt(x, x v y) = x.

  % BGA2a: tensor associative
  (x * y) * z = x * (y * z).

  % BGA2b: tensor commutative
  x * y = y * x.

  % BGA2c: tensor unit eo
  x * eo = x.

  % BGA3: residuation:  a (x) b <= c  <->  b <= a -> c
  ((x * y) v z = z) <-> (y v res(x,z) = res(x,z)).

  % BGA4a: polarity defined from the residual
  star(x) = res(x, ep).

  % BGA4b: the polarity is involutive
  star(star(x)) = x.

end_of_list.

formulas(goals).

  % Lemma (4):  a <= b  ==>  res(b,z) <= res(a,z)
  (x v y = y) -> (res(y,z) v res(x,z) = res(x,z)).

end_of_list.


%% ==== Block lemA-5: Lemma (4) with z := ep:  star is antitone ====
%% Bai bao / paper: thm:bga-implies-ps (doc4-compare.tex)
%% Gia thiet / hypotheses: BGA1-BGA3 (+ dinh nghia star); KHONG dung BGA5. BGA1-BGA3 plus the definition of star; BGA5 unused.
